{
  "manifest_version": 2,
  "name": "Nighttime Red Light",
  "version": "0.3.0",
  "description": "Red-only page filter for winding down at night, with dimming and scheduling by time or sunset/sunrise. Firefox desktop and Android.",
  "browser_specific_settings": {
    "gecko": {
      "id": "red-filter@mtgambeloak.github.io",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "storage",
    "theme",
    "alarms",
    "<all_urls>"
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "scripts": [
      "lib/suncalc.js",
      "common.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/suncalc.js",
        "common.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "Nighttime Red Light",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
